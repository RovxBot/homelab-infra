<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>beer.cooked.giteaci</string>
  <key>UserName</key><string>giteaci</string>
  <key>ProgramArguments</key><array>
    <string>/Users/giteaci/runner/gitea-runner</string>
    <string>--config</string><string>/Users/giteaci/runner/macos.yaml</string>
    <string>daemon</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/giteaci/runner</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/giteaci/runner/daemon.log</string>
  <key>StandardErrorPath</key><string>/Users/giteaci/runner/daemon-error.log</string>
</dict></plist>
