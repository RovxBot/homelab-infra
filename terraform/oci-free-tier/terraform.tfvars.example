tenancy_ocid     = "ocid1.tenancy.oc1..example"
user_ocid        = "ocid1.user.oc1..example"
fingerprint      = "aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"
private_key_path = "~/.oci/oci_api_key.pem"
region           = "ap-melbourne-1"
compartment_ocid = "ocid1.compartment.oc1..example"

ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# The WireGuard edge is administered through its private tunnel, so it has no
# OCI public SSH ingress. Keep Matrix separate until it has its own tested
# management path; its legacy public SSH default is retained for compatibility.
wireguard_ssh_ingress_cidrs = []
# matrix_ssh_ingress_cidrs = ["your-static-admin-cidr/32"]

# Current live WireGuard VPS in Melbourne:
# - shape: VM.Standard.E2.1.Micro
# - image: current Ubuntu x86_64 image OCID shown below
wireguard_shape      = "VM.Standard.E2.1.Micro"
wireguard_image_ocid = "ocid1.image.oc1.ap-melbourne-1.aaaaaaaayettssu2b7iwidreqlrwshrvrz5byufo64cbvusn4mdwo2nnvuya"

# Optional: pin the AD if your region has more than one.
# availability_domain_name = "FnnO:AP-MELBOURNE-1-AD-1"

# Current live VPS sizing.
wireguard_ocpus      = 1
wireguard_memory_gbs = 1

# Optional: restore the private administrator WireGuard peer on a fresh edge
# boot volume. This is public key material; store the corresponding private key
# only on the administrator workstation or in Bitwarden.
# wireguard_admin_public_key = "base64-wireguard-public-key="
wireguard_admin_address = "10.77.0.3/32"

# Legacy Matrix resources are disabled in the edge module. Provision Matrix
# through its independent Terraform module when Oracle ARM capacity is available.
matrix_enabled       = false
matrix_instance_name = "matrix"
matrix_shape         = "VM.Standard.A1.Flex"
matrix_ocpus         = 2
matrix_memory_gbs    = 8
matrix_server_name   = "matrix.example.com"
matrix_acme_email    = "ops@example.com"

# Optional: pin a specific ARM image instead of auto-selecting the latest compatible Ubuntu image.
# matrix_image_ocid = "ocid1.image.oc1.ap-melbourne-1...."
#
# Optional: pin the Ubuntu release when auto-selecting.
# matrix_operating_system         = "Canonical Ubuntu"
# matrix_operating_system_version = "24.04"

# Optional: report anonymized Synapse stats upstream.
# matrix_report_stats = false

# Optional: tighten or widen the TURN relay UDP range for coturn.
# matrix_turn_min_port = 49152
# matrix_turn_max_port = 49200

# Optional: if set, cloud-init writes /etc/wireguard/wg0.conf and starts wg-quick@wg0.
# The repo-managed path is terraform/oci-free-tier/wireguard-peer-config.enc.yaml.
# Prefer that file over inlining this secret in terraform.tfvars or Terraform Cloud.
# wireguard_peer_config = <<-EOT
# [Interface]
# Address = 10.77.0.1/24
# MTU = 1370
# ListenPort = 51820
# PrivateKey = ...
#
# [Peer]
# PublicKey = ...
# AllowedIPs = 10.77.0.2/32
# EOT
