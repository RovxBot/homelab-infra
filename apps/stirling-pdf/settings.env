TZ=Australia/Adelaide
# Native Stirling authentication protects the service and assigns user roles.
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8080
# Allow existing browser cookies during migration away from the gateway.
SERVER_MAX_HTTP_REQUEST_HEADER_SIZE=32KB
SERVER_FORWARD_HEADERS_STRATEGY=framework
SECURITY_ENABLELOGIN=true
SECURITY_LOGINMETHOD=oauth2
SECURITY_SSOAUTOLOGIN=true
SECURITY_OAUTH2_ENABLED=true
SECURITY_OAUTH2_PROVIDER=entra
SECURITY_OAUTH2_ISSUER=https://login.microsoftonline.com/345cd18b-5bee-4ac4-b729-a3f7059a28f3/v2.0
SECURITY_OAUTH2_SCOPES=openid,profile,email
SECURITY_OAUTH2_USEASUSERNAME=preferred_username
SECURITY_OAUTH2_AUTOCREATEUSER=true
SECURITY_OAUTH2_BLOCKREGISTRATION=false
SECURITY_OAUTH2_REDIRECTBASEURL=https://stirling.cooked.beer
SYSTEM_BACKENDURL=https://stirling.cooked.beer
SYSTEM_FRONTENDURL=https://stirling.cooked.beer
SYSTEM_CORSALLOWEDORIGINS=https://stirling.cooked.beer
SYSTEM_DEFAULTLOCALE=en-GB
SYSTEM_GOOGLEVISIBILITY=false
SYSTEM_ENABLEANALYTICS=false
SYSTEM_ENABLEPOSTHOG=false
SYSTEM_ENABLESCARF=false
SYSTEM_SHOWUPDATE=false
SYSTEM_ENABLEURLTOPDF=true
SYSTEM_ENABLEMOBILESCANNER=true
SYSTEM_ENABLEMOBILESIGNATURE=true
SYSTEM_SERVERCERTIFICATE_ORGANIZATIONNAME=cooked.beer
STORAGE_ENABLED=true
STORAGE_PROVIDER=local
STORAGE_LOCAL_BASEPATH=/storage
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=95MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=100MB
AIENGINE_ENABLED=false
JAVA_CUSTOM_OPTS=-Xms256m -Xmx1536m
# Require the upstream LibreOffice Landlock sandbox on the Talos 6.18 kernel.
STIRLING_LO_SANDBOX=required
