Environment=prod
OPENBREW_SQL_HOST=openbrew-db
OPENBREW_SQL_PORT=1433
OPENBREW_DB_NAME=Openbrew
OPENBREW_SQL_ADMIN_USER=sa
OPENBREW_DB_INIT_SCRIPT=/app/Setup/Database/Build.20150807/20150807_initial.sql
OPENBREW_ROOT_URL=https://openbrew.cooked.beer
OPENBREW_ROOT_URL_SECURE=https://openbrew.cooked.beer
OPENBREW_STATIC_ROOT_URL=https://openbrew.cooked.beer
OPENBREW_STATIC_ROOT_URL_SECURE=https://openbrew.cooked.beer
OPENBREW_MEDIA_PHYSICAL_ROOT=/runtime/Media
OPENBREW_CONTACT_EMAIL_ADDRESS=sam@cooked.beer
OPENBREW_ALLOWED_EMAIL=sam@cooked.beer
HOME=/tmp
TZ=Australia/Adelaide
TURNSTILE_ENABLED=false
