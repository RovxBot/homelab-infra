diff --git a/custom_components/airtouch2plus/reliable_client.py b/custom_components/airtouch2plus/reliable_client.py
new file mode 100644
index 0000000..7f5a33d
--- /dev/null
+++ b/custom_components/airtouch2plus/reliable_client.py
@@ -0,0 +1,209 @@
+"""Local reliability fixes for airtouch2 0.8.7; see the homelab patch notes."""
+from __future__ import annotations
+
+import asyncio
+from collections.abc import Callable
+from contextlib import suppress
+import logging
+from time import monotonic
+
+from airtouch2.at2plus import At2PlusClient, At2PlusAircon
+from airtouch2.common.NetClient import NetClient
+from airtouch2.protocol.at2plus.messages.AcStatus import AcStatusMessage
+from airtouch2.protocol.at2plus.messages.GroupStatus import GroupStatusMessage
+from homeassistant.exceptions import HomeAssistantError
+
+_LOGGER = logging.getLogger(__name__)
+STATUS_INTERVAL = 15
+STATUS_MAX_AGE = 45
+COMMAND_TIMEOUT = 10
+
+
+class ReliableTransport(NetClient):
+    """Never report a command delivered after reconnecting without resending it."""
+
+    @property
+    def connected(self):
+        return bool(self._writer and not self._writer.is_closing()
+                    and self._reader and not self._reader.at_eof())
+
+    async def connect(self):
+        if self._writer:
+            self._writer.close()
+        return await super().connect()
+
+    async def send(self, message):
+        if not self.connected:
+            raise ConnectionError("AirTouch controller is disconnected")
+        # Reconnection belongs to the reader. The original send() can reconnect
+        # while drain() fails and return success without writing the command again.
+        self._writer.write(message.to_bytes())
+        await self._writer.drain()
+
+    async def stop(self):
+        self._stop = True
+        if self._main_loop_task:
+            self._main_loop_task.cancel()
+            with suppress(asyncio.CancelledError, Exception):
+                await self._main_loop_task
+        if self._writer:
+            self._writer.close()
+            with suppress(OSError, TimeoutError):
+                async with asyncio.timeout(2):
+                    await self._writer.wait_closed()
+
+    async def _main(self):
+        while not self._stop:
+            try:
+                await self._handle_message()
+            except (OSError, asyncio.IncompleteReadError):
+                await self._try_reconnect()
+            except (ValueError, KeyError, IndexError):
+                # A malformed/unsupported packet must not kill all future updates.
+                _LOGGER.warning("Ignoring malformed AirTouch message", exc_info=True)
+
+    async def _try_reconnect(self):
+        while not self._stop:
+            try:
+                async with asyncio.timeout(10):
+                    if await self.connect():
+                        return
+            except (OSError, TimeoutError):
+                pass
+            await asyncio.sleep(5)
+
+
+class ReliableAirTouchClient(At2PlusClient):
+    """Keep push updates, with status requests and bounded command confirmation."""
+
+    def __init__(self, host):
+        self._tasks = set()
+        super().__init__(host, task_creator=self._create_task)
+        self._client = ReliableTransport(
+            host, 9200, self._on_connect, self.handle_one_message, self._create_task
+        )
+        self._status_times = {}
+        self._listeners = []
+        self._command_lock = asyncio.Lock()
+        self._ability_lock = asyncio.Lock()
+
+    def _create_task(self, coroutine):
+        task = asyncio.create_task(coroutine)
+        self._tasks.add(task)
+        def done(finished):
+            self._tasks.discard(finished)
+            if not finished.cancelled() and (error := finished.exception()):
+                _LOGGER.error("AirTouch background task failed: %s", error)
+        task.add_done_callback(done)
+        return task
+
+    async def _on_connect(self):
+        self._status_times.clear()
+        self._notify()
+        await super()._on_connect()
+
+    def run(self):
+        super().run()
+        self._create_task(self._poll_status())
+
+    def available(self, device):
+        return (self._client.connected
+                and monotonic() - self._status_times.get(id(device), float('-inf')) < STATUS_MAX_AGE)
+
+    def add_listener(self, callback):
+        self._listeners.append(callback)
+        def remove():
+            if callback in self._listeners:
+                self._listeners.remove(callback)
+        return remove
+
+    def _notify(self):
+        for callback in tuple(self._listeners):
+            callback()
+
+    async def request_status(self):
+        await self.send(AcStatusMessage([]))
+        await self.send(GroupStatusMessage([]))
+
+    async def _poll_status(self):
+        while True:
+            await asyncio.sleep(STATUS_INTERVAL)
+            try:
+                async with asyncio.timeout(5):
+                    await self.request_status()
+            except (OSError, TimeoutError):
+                self._status_times.clear()
+            self._notify()
+
+    async def _handle_status_message(self, message):
+        for status in message.statuses:
+            ac = self.aircons_by_id.get(status.id)
+            if ac is None:
+                ac = self.aircons_by_id[status.id] = At2PlusAircon(status, self)
+                self._status_times[id(ac)] = monotonic()
+                for callback in tuple(self._new_ac_callbacks):
+                    callback()
+                self._create_task(self._load_ability(ac))
+            self._status_times[id(ac)] = monotonic()
+            # Publish immediately. Upstream waits for ability then publishes the
+            # FIRST status, overwriting newer on/off packets received in between.
+            ac._update_status(status)
+
+    async def _load_ability(self, ac):
+        # Upstream has one shared ability response queue; requests must serialize.
+        async with self._ability_lock:
+            while ac.ability is None:
+                try:
+                    async with asyncio.timeout(10):
+                        ability = await self._request_ac_ability(ac.status.id)
+                    if ability is not None:
+                        ac._set_ability(ability)
+                        ac._update_status(ac.status)
+                except (OSError, TimeoutError):
+                    pass
+                if ac.ability is None:
+                    await asyncio.sleep(5)
+
+    async def _handle_group_status_message(self, message):
+        # Mark existing groups fresh before their callbacks publish state.
+        for status in message.statuses:
+            if group := self.groups_by_id.get(status.id):
+                self._status_times[id(group)] = monotonic()
+        await super()._handle_group_status_message(message)
+        for status in message.statuses:
+            group = self.groups_by_id[status.id]
+            self._status_times[id(group)] = monotonic()
+        self._notify()
+
+    async def command(self, device, send: Callable, matches: Callable):
+        """Require a fresh matching status; do not invent optimistic HVAC state."""
+        async with self._command_lock:
+            confirmed = asyncio.Event()
+            previous_status = self._status_times.get(id(device))
+            def updated():
+                if self._status_times.get(id(device)) != previous_status and matches():
+                    confirmed.set()
+            remove = device.add_callback(updated)
+            try:
+                async with asyncio.timeout(COMMAND_TIMEOUT):
+                    await send()
+                    await self.request_status()
+                    await confirmed.wait()
+            except (OSError, TimeoutError) as error:
+                # A timeout means the requested operation was not confirmed.
+                # Keep the actual last state and expose unavailability if stale.
+                raise HomeAssistantError(
+                    "AirTouch did not confirm the change. Check the controller and retry."
+                ) from error
+            finally:
+                remove()
+                self._notify()
+
+    async def stop(self):
+        await self._client.stop()
+        tasks = tuple(self._tasks)
+        for task in tasks:
+            task.cancel()
+        await asyncio.gather(*tasks, return_exceptions=True)
+        self._status_times.clear()
+        self._notify()
