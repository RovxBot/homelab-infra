{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":enableVulnerabilityAlerts",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Australia/Melbourne",
  "labels": [
    "dependencies"
  ],
  "rebaseWhen": "behind-base-branch",
  "prCreation": "immediate",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 3,
  "branchConcurrentLimit": 3,
  "dependencyDashboardTitle": "Renovate Dependency Dashboard",
  "enabledManagers": [
    "dockerfile",
    "flux",
    "github-actions",
    "kubernetes",
    "terraform"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)(apps|infra|clusters|ops)/.+\\.ya?ml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/(^|/)(apps|infra|clusters)/.+\\.ya?ml$/"
    ]
  },
  "ignorePaths": [
    "**/*.b64",
    "age-key.txt",
    "clusters/home/flux-system/gotk-components.yaml",
    "immich_backup_*.sql"
  ],
  "packageRules": [
    {
      "description": "Keep the generated Flux bootstrap manifest under an explicit, digest-pinned maintenance workflow.",
      "matchManagers": [
        "flux"
      ],
      "matchFileNames": [
        "clusters/home/flux-system/gotk-components.yaml"
      ],
      "enabled": false
    },
    {
      "description": "Cilium OCI chart upgrades require the dedicated primary-CNI maintenance runbook; avoid an unresolvable digest lookup.",
      "matchManagers": [
        "flux"
      ],
      "matchFileNames": [
        "infra/cilium/ocirepository.yaml"
      ],
      "enabled": false
    },
    {
      "description": "Require an explicit review for every infrastructure dependency update.",
      "matchManagers": [
        "dockerfile",
        "flux",
        "github-actions",
        "kubernetes",
        "terraform"
      ],
      "automerge": false
    },
    {
      "description": "Group GitHub Action updates so workflow pins move together.",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions",
      "groupSlug": "github-actions",
      "automerge": false
    },
    {
      "description": "Keep free-tier Terraform provider changes isolated from the deferred Matrix stack.",
      "matchManagers": [
        "terraform"
      ],
      "matchFileNames": [
        "terraform/oci-free-tier/**"
      ],
      "groupName": "oci-free-tier-terraform",
      "groupSlug": "oci-free-tier-terraform",
      "automerge": false
    },
    {
      "description": "Keep the intentionally independent Matrix Terraform provider changes isolated.",
      "matchManagers": [
        "terraform"
      ],
      "matchFileNames": [
        "terraform/oci-matrix-free-tier/**"
      ],
      "groupName": "oci-matrix-free-tier-terraform",
      "groupSlug": "oci-matrix-free-tier-terraform",
      "automerge": false
    },
    {
      "description": "Require dashboard approval before an OCI provider major update changes the active free-tier stack.",
      "matchManagers": [
        "terraform"
      ],
      "matchFileNames": [
        "terraform/oci-free-tier/**"
      ],
      "matchPackageNames": [
        "oracle/oci"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Defer every independent Matrix Terraform update until its capacity-backed rollout is planned.",
      "matchManagers": [
        "terraform"
      ],
      "matchFileNames": [
        "terraform/oci-matrix-free-tier/**"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Keep the Grim Guzzler registration image build dependencies reviewable as one application change.",
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "ops/grimguzzler-registration/Dockerfile"
      ],
      "groupName": "grimguzzler-registration-image",
      "groupSlug": "grimguzzler-registration-image",
      "automerge": false
    },
    {
      "description": "Require dashboard approval before a PHP runtime line upgrade is proposed.",
      "matchFileNames": [
        "ops/grimguzzler-registration/Dockerfile"
      ],
      "matchPackageNames": [
        "php"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "dependencyDashboardApproval": true,
      "labels": [
        "dependencies",
        "runtime-upgrade"
      ],
      "automerge": false
    },
    {
      "description": "Kubernetes image updates (pin digests).",
      "matchManagers": [
        "kubernetes"
      ],
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "description": "Use regex versioning for LinuxServer tags with -ls revisions.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "linuxserver/prowlarr",
        "linuxserver/radarr",
        "linuxserver/sabnzbd",
        "linuxserver/sonarr"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?-ls(?<revision>\\d+)$"
    },
    {
      "description": "Group Immich image updates together.",
      "matchFileNames": [
        "apps/immich/**"
      ],
      "groupName": "immich",
      "groupSlug": "immich"
    },
    {
      "description": "Keep Jellyfin dependencies in an independently testable update.",
      "matchFileNames": [
        "apps/jellyfin/**"
      ],
      "groupName": "jellyfin",
      "groupSlug": "jellyfin"
    },
    {
      "description": "Keep Jellyseerr dependencies in an independently testable update.",
      "matchFileNames": [
        "apps/jellyseerr/**"
      ],
      "groupName": "jellyseerr",
      "groupSlug": "jellyseerr"
    },
    {
      "description": "Keep Prowlarr dependencies in an independently testable update.",
      "matchFileNames": [
        "apps/prowlarr/**"
      ],
      "groupName": "prowlarr",
      "groupSlug": "prowlarr"
    },
    {
      "description": "Keep Radarr dependencies in an independently testable update.",
      "matchFileNames": [
        "apps/radarr/**"
      ],
      "groupName": "radarr",
      "groupSlug": "radarr"
    },
    {
      "description": "Keep SABnzbd dependencies in an independently testable update.",
      "matchFileNames": [
        "apps/sabnzbd/**"
      ],
      "groupName": "sabnzbd",
      "groupSlug": "sabnzbd"
    },
    {
      "description": "Keep Sonarr dependencies in an independently testable update.",
      "matchFileNames": [
        "apps/sonarr/**"
      ],
      "groupName": "sonarr",
      "groupSlug": "sonarr"
    },
    {
      "description": "Group InvoiceNinja stack updates together.",
      "matchFileNames": [
        "apps/invoiceninja/**"
      ],
      "groupName": "invoiceninja",
      "groupSlug": "invoiceninja"
    },
    {
      "description": "Keep Homepage dependencies separate from the cluster-health reporter.",
      "matchFileNames": [
        "apps/homepage/**"
      ],
      "groupName": "homepage",
      "groupSlug": "homepage"
    },
    {
      "description": "Keep the cluster-health reporter dependencies separate from Homepage.",
      "matchFileNames": [
        "infra/pod-report/**"
      ],
      "groupName": "cluster-health-reporter",
      "groupSlug": "cluster-health-reporter"
    },
    {
      "description": "Keep Cloudflare tunnel dependencies separate from VPN changes.",
      "matchFileNames": [
        "infra/cloudflared/**"
      ],
      "groupName": "cloudflared",
      "groupSlug": "cloudflared"
    },
    {
      "description": "Keep WireGuard image updates separate from public-edge Terraform changes.",
      "matchFileNames": [
        "infra/wireguard/**",
        "terraform/oci-free-tier/ops/wireguard/**"
      ],
      "groupName": "wireguard",
      "groupSlug": "wireguard"
    },
    {
      "description": "Group observability updates together.",
      "matchFileNames": [
        "infra/observability/**",
        "infra/observability-config/**"
      ],
      "groupName": "observability",
      "groupSlug": "observability",
      "automerge": false
    },
    {
      "description": "Group Longhorn chart and node-disk changes as one storage update.",
      "matchFileNames": [
        "infra/longhorn/**",
        "infra/longhorn-node-disks/**"
      ],
      "groupName": "longhorn",
      "groupSlug": "longhorn",
      "automerge": false
    },
    {
      "description": "Group Kyverno engine and policy automation updates together.",
      "matchFileNames": [
        "infra/kyverno/**",
        "infra/kyverno-policies/**"
      ],
      "groupName": "kyverno",
      "groupSlug": "kyverno",
      "automerge": false
    },
    {
      "description": "Keep the NVIDIA GPU Operator chart independently reviewable.",
      "matchFileNames": [
        "infra/gpu-operator/**"
      ],
      "groupName": "gpu-operator",
      "groupSlug": "gpu-operator",
      "automerge": false
    },
    {
      "description": "Require a maintenance decision before cluster-control Helm upgrades.",
      "matchManagers": [
        "flux"
      ],
      "matchFileNames": [
        "infra/kyverno/helmrelease.yaml",
        "infra/longhorn/longhorn-helmrelease.yaml",
        "infra/gpu-operator/helmrelease.yaml"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Disable major database image upgrades; handle these with explicit migration plans.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/immich-app/postgres",
        "mysql"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Keep custom WotLK image promotion tags under the dedicated game-image pipeline.",
      "matchManagers": [
        "kubernetes"
      ],
      "matchFileNames": [
        "apps/wotlk/**"
      ],
      "matchPackageNames": [
        "ghcr.io/rovxbot/azerothcore-wotlk"
      ],
      "enabled": false
    },
    {
      "description": "Group routine WotLK helper-image digest and patch updates without touching the pipeline-owned game images.",
      "matchManagers": [
        "kubernetes"
      ],
      "matchFileNames": [
        "apps/wotlk/**"
      ],
      "matchPackageNames": [
        "alpine",
        "alpine/git",
        "bitnami/kubectl"
      ],
      "groupName": "wotlk-helper-images",
      "groupSlug": "wotlk-helper-images",
      "automerge": false
    },
    {
      "description": "Require dashboard approval before a WotLK MySQL minor update is proposed.",
      "matchManagers": [
        "kubernetes"
      ],
      "matchFileNames": [
        "apps/wotlk/**"
      ],
      "matchPackageNames": [
        "mysql"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Require dashboard approval before a WotLK Ubuntu base-image line update is proposed.",
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "ops/wotlk-images/Dockerfile"
      ],
      "matchPackageNames": [
        "ubuntu"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Don't auto-merge major updates.",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
