{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":enableVulnerabilityAlerts",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Australia/Adelaide",
  "labels": [
    "dependencies"
  ],
  "rebaseWhen": "conflicted",
  "prCreation": "immediate",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "dependencyDashboardTitle": "Renovate Dependency Dashboard",
  "dependencyDashboardApproval": false,
  "vulnerabilityAlerts": {
    "enabled": true,
    "dependencyDashboardApproval": false,
    "prCreation": "immediate",
    "addLabels": [
      "security"
    ],
    "groupName": null,
    "schedule": [],
    "updateNotScheduled": true,
    "rebaseWhen": "behind-base-branch",
    "automerge": false,
    "groupSlug": null,
    "minimumGroupSize": 1,
    "commitMessageTopic": "{{{depName}}}",
    "commitMessageExtra": "to {{newVersion}}"
  },
  "enabledManagers": [
    "dockerfile",
    "custom.regex",
    "flux",
    "github-actions",
    "kubernetes",
    "terraform"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)(apps|infra|clusters|ops)/.+\\.ya?ml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/(^|/)(apps|infra|clusters)/.+\\.ya?ml$/"
    ]
  },
  "ignorePaths": [
    "**/*.b64",
    "age-key.txt",
    "clusters/home/flux-system/gotk-components.yaml",
    "immich_backup_*.sql"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^apps\\/gitea\\/helmrelease\\.yaml$/"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "docker.gitea.com/gitea",
      "versioningTemplate": "docker",
      "currentValueTemplate": "{{{tag}}}-rootless",
      "matchStrings": [
        "    image:\\n      registry: docker\\.gitea\\.com\\n      repository: gitea\\n      tag: (?<tag>\\d+\\.\\d+\\.\\d+)\\n      digest: (?<currentDigest>sha256:[a-f0-9]{64})\\n      rootless: true"
      ],
      "autoReplaceStringTemplate": "    image:\n      registry: docker.gitea.com\n      repository: gitea\n      tag: {{replace '-rootless' '' newValue}}\n      digest: {{{newDigest}}}\n      rootless: true"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^terraform\\/oci-matrix-free-tier\\/variables\\.tf$/"
      ],
      "datasourceTemplate": "docker",
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>\\S+)\\s+default\\s+=\\s+\\\"[^\\\"]+:(?<currentValue>[^@\\\"]+)@(?<currentDigest>sha256:[a-f0-9]+)\\\""
      ]
    }
  ],
  "schedule": [
    "* 6-17 * * 1"
  ],
  "updateNotScheduled": false,
  "automerge": false,
  "groupSingleUpdates": true,
  "minimumGroupSize": 1,
  "semanticCommits": "disabled",
  "packageRules": [
    {
      "description": "Fallback application release groups keep related non-routine components together, including multiple deployments. Routine updates join weekly maintenance below.",
      "matchFileNames": [
        "apps/**"
      ],
      "groupName": "{{ lookup (split packageFile '/') 1 }} release",
      "separateMajorMinor": false,
      "groupSlug": "{{ lookup (split packageFile '/') 1 }}-release"
    },
    {
      "description": "Routine patches, digests and pins share one Monday PR, including Docker references extracted from Terraform. Critical overrides follow this rule.",
      "matchUpdateTypes": [
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "weekly maintenance",
      "groupSlug": "weekly-maintenance",
      "dependencyDashboardApproval": false,
      "prPriority": 10,
      "commitMessageAction": "Update",
      "commitMessageTopic": "{{groupName}}",
      "commitMessageExtra": "",
      "group": {
        "commitMessageTopic": "{{groupName}}",
        "commitMessageExtra": "",
        "branchTopic": "{{{groupSlug}}}"
      },
      "rebaseWhen": "conflicted"
    },
    {
      "description": "Explicitly approved minor releases; unlisted minors remain separately reviewable. Runtime, identity, provider and controller exceptions follow.",
      "matchManagers": [
        "dockerfile",
        "custom.regex",
        "flux",
        "kubernetes"
      ],
      "matchDatasources": [
        "docker",
        "helm"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "matchPackageNames": [
        "alpine",
        "alpine/git",
        "busybox",
        "nginxinc/nginx-unprivileged",
        "docker/dockerfile",
        "composer",
        "docker.gitea.com/gitea",
        "docker.gitea.com/gitea-mcp-server",
        "docker.gitea.com/runner",
        "ghcr.io/raylabshq/gitea-mirror",
        "gitea",
        "ghcr.io/gethomepage/homepage",
        "ghcr.io/immich-app/immich-server",
        "ghcr.io/immich-app/immich-machine-learning",
        "invoiceninja/invoiceninja",
        "jellyfin/jellyfin",
        "linuxserver/prowlarr",
        "linuxserver/radarr",
        "linuxserver/sabnzbd",
        "linuxserver/sonarr",
        "seerr/seerr",
        "neosmemo/memos",
        "ghcr.io/stirling-tools/stirling-pdf",
        "wger/server",
        "journeyapps/powersync-service",
        "postgres",
        "redis"
      ],
      "groupName": "weekly maintenance",
      "groupSlug": "weekly-maintenance",
      "dependencyDashboardApproval": false,
      "prPriority": 10,
      "commitMessageAction": "Update",
      "commitMessageTopic": "{{groupName}}",
      "commitMessageExtra": "",
      "group": {
        "commitMessageTopic": "{{groupName}}",
        "commitMessageExtra": "",
        "branchTopic": "{{{groupSlug}}}"
      },
      "rebaseWhen": "conflicted"
    },
    {
      "description": "BirdNET uses stable date tags, whose date changes Docker classifies as major. Both container occurrences share the weekly branch.",
      "matchManagers": [
        "kubernetes"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "apps/birdnet-go/deployment.yaml"
      ],
      "matchPackageNames": [
        "ghcr.io/tphakala/birdnet-go"
      ],
      "allowedVersions": "/^\\d{8}$/",
      "groupName": "weekly maintenance",
      "groupSlug": "weekly-maintenance",
      "separateMajorMinor": false,
      "dependencyDashboardApproval": false,
      "prPriority": 10,
      "commitMessageAction": "Update",
      "commitMessageTopic": "{{groupName}}",
      "commitMessageExtra": "",
      "group": {
        "commitMessageTopic": "{{groupName}}",
        "commitMessageExtra": "",
        "branchTopic": "{{{groupSlug}}}"
      },
      "rebaseWhen": "conflicted"
    },
    {
      "description": "CI language runtime line upgrades are independent per language, including Python minors. Home Assistant retains its separate version constraint.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "uses-with"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "groupName": "CI {{depName}} runtime",
      "groupSlug": "ci-{{depName}}-runtime",
      "dependencyDashboardApproval": true,
      "prPriority": 0
    },
    {
      "description": "Major Actions, reusable workflows and hosted-runner changes remain independent per dependency, across all workflows using that dependency.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "action",
        "workflow",
        "github-runner"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null,
      "groupSlug": null
    },
    {
      "description": "Both Gitea runner deployments move together for a major upgrade, independently of the Gitea application.",
      "matchPackageNames": [
        "docker.gitea.com/runner"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "Gitea runners",
      "groupSlug": "gitea-runners",
      "dependencyDashboardApproval": true,
      "prPriority": 0
    },
    {
      "description": "Terraform providers/modules/CLI are reviewed per dependency, never grouped just by directory. Custom Docker references are handled by image policies.",
      "matchManagers": [
        "terraform"
      ],
      "groupName": null,
      "groupSlug": null,
      "dependencyDashboardApproval": true,
      "prPriority": 0,
      "commitMessageTopic": "Terraform dependency {{depName}}"
    },
    {
      "description": "Control-plane, storage and admission changes always require a maintenance decision. The Python-only automation exception is below.",
      "matchFileNames": [
        "infra/cilium/**",
        "infra/kyverno/**",
        "infra/kyverno-policies/**",
        "infra/longhorn/**",
        "infra/longhorn-node-disks/**",
        "infra/gpu-operator/**",
        "infra/snapshot-controller/**",
        "clusters/home/flux-system/**"
      ],
      "groupName": "{{replace '-(node-disks|policies)$' '' (lookup (split packageFile '/') 1)}}",
      "groupSlug": null,
      "separateMajorMinor": false,
      "dependencyDashboardApproval": true,
      "prPriority": 0
    },
    {
      "description": "Authentication and identity changes remain isolated even for patches and digests, including the Matrix images embedded in Terraform.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "vaultwarden/server",
        "quay.io/oauth2-proxy/oauth2-proxy",
        "ghcr.io/element-hq/synapse",
        "vectorim/element-web"
      ],
      "groupName": "identity {{depNameSanitized}}",
      "groupSlug": "identity-{{depNameSanitized}}",
      "separateMajorMinor": false,
      "dependencyDashboardApproval": true,
      "prPriority": 0
    },
    {
      "description": "Keep Home Assistant release-line changes outside maintenance while AirTouch compatibility is repaired (#2021); supporting patches still batch normally.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/home-assistant/home-assistant"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "groupName": "Home Assistant release",
      "groupSlug": "home-assistant",
      "dependencyDashboardApproval": true,
      "prPriority": 0
    },
    {
      "description": "OS, language and MySQL release-line changes need explicit compatibility review, including coordinated WotLK MySQL occurrences.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "php",
        "python",
        "node",
        "ubuntu",
        "mysql"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "groupName": "{{ lookup (split packageFile '/') 1 }} {{depName}} runtime",
      "groupSlug": "{{ lookup (split packageFile '/') 1 }}-{{depName}}-runtime",
      "dependencyDashboardApproval": true,
      "prPriority": 0
    },
    {
      "description": "Only the tested Python automation images may bypass the controller maintenance gate. Major interpreter changes remain gated.",
      "matchManagers": [
        "kubernetes"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "python"
      ],
      "matchFileNames": [
        "infra/kyverno/automation/github-issue-sync-cronjob.yaml",
        "infra/longhorn/weekly-backup-retention.yaml",
        "infra/observability/gatus-github-issue-sync-cronjob.yaml",
        "ops/longhorn/reviewed-backup-retention-job.yaml",
        "apps/birdnet-go/deployment.yaml"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "weekly maintenance",
      "groupSlug": "weekly-maintenance",
      "dependencyDashboardApproval": false,
      "prPriority": 10,
      "commitMessageAction": "Update",
      "commitMessageTopic": "{{groupName}}",
      "commitMessageExtra": "",
      "group": {
        "commitMessageTopic": "{{groupName}}",
        "commitMessageExtra": "",
        "branchTopic": "{{{groupSlug}}}"
      },
      "rebaseWhen": "conflicted"
    },
    {
      "description": "Keep Home Assistant regression tests on Python 3.14, matching the deployed release. Review this constraint when Home Assistant changes its Python runtime.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "uses-with"
      ],
      "matchDepNames": [
        "python"
      ],
      "matchFileNames": [
        ".github/workflows/home-assistant-checks.yml"
      ],
      "allowedVersions": "/^3\\.14(?:\\.|$)/"
    },
    {
      "description": "Use regex versioning for LinuxServer tags with -ls revisions.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "linuxserver/prowlarr",
        "linuxserver/radarr",
        "linuxserver/sabnzbd",
        "linuxserver/sonarr"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?-ls(?<revision>\\d+)$"
    },
    {
      "description": "Jellyfin 12 uses a two-component stable Docker tag (12.0), while the 10.x tags use three components. Normalize the optional patch component so Renovate can detect the major upgrade.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "jellyfin/jellyfin"
      ],
      "matchFileNames": [
        "apps/jellyfin/**"
      ],
      "versioning": "regex:^(?<major>\\d+)(?:\\.(?<minor>\\d+))?(?:\\.(?<patch>\\d+))?$"
    },
    {
      "description": "Track the Wger 2.7 prerelease required by the mobile application; keep the exception limited to the Wger server image.",
      "matchPackageNames": [
        "wger/server"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "apps/wger/**"
      ],
      "ignoreUnstable": false,
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?(?:-(?:alpha|beta|rc)(?<prerelease>\\d+))?$"
    },
    {
      "description": "Only stable, coordinated Immich release tags are eligible; CI rejects mismatched server and machine-learning versions. Keep public Docker discovery enabled.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/immich-app/immich-server",
        "ghcr.io/immich-app/immich-machine-learning"
      ],
      "allowedVersions": "/^v\\d+\\.\\d+\\.\\d+$/"
    },
    {
      "description": "Database major upgrades need an explicit migration and rollback plan, including custom Terraform image extraction. Redis majors are also excluded.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/immich-app/postgres",
        "mysql",
        "mariadb",
        "postgres",
        "redis",
        "mcr.microsoft.com/mssql/server"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Immutable pipeline outputs are promoted by their owning workflows, including references embedded in admission policies. Upstream Dockerfile bases remain tracked.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/rovxbot/gitea-linux",
        "ghcr.io/rovxbot/gitea-backup",
        "git.cooked.beer/github-dr/wowdecomp-linux-toolchain",
        "ghcr.io/rovxbot/kubernetes-mcp",
        "ghcr.io/rovxbot/azerothcore-wotlk",
        "ghcr.io/rovxbot/skyfire-mop",
        "ghcr.io/rovxbot/grimguzzler-registration",
        "ghcr.io/rovxbot/openbrew-sqlserver"
      ],
      "enabled": false
    },
    {
      "description": "The custom regex manager updates Gitea's rootless tag and separate digest together; Flux's generic Helm image extraction ignores both the rootless suffix and digest field.",
      "matchManagers": [
        "flux"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "docker.gitea.com/gitea"
      ],
      "matchFileNames": [
        "apps/gitea/helmrelease.yaml"
      ],
      "enabled": false
    },
    {
      "description": "Keep the generated Flux bootstrap manifest under an explicit, digest-pinned maintenance workflow.",
      "matchManagers": [
        "flux"
      ],
      "matchFileNames": [
        "clusters/home/flux-system/gotk-components.yaml"
      ],
      "enabled": false
    },
    {
      "description": "Cilium OCI chart upgrades require the dedicated primary-CNI maintenance runbook; avoid an unresolvable digest lookup.",
      "matchManagers": [
        "flux"
      ],
      "matchFileNames": [
        "infra/cilium/ocirepository.yaml"
      ],
      "enabled": false
    },
    {
      "description": "Kyverno remains a separate high-risk admission PR, including compatible patches; no automerge.",
      "matchManagers": [
        "flux"
      ],
      "matchPackageNames": [
        "kyverno"
      ],
      "groupName": "kyverno",
      "groupSlug": null,
      "automerge": false,
      "dependencyDashboardApproval": true,
      "separateMajorMinor": false
    }
  ]
}
